# Copy to .env.staging at the project root. Use unique private values.
DJANGO_SECRET_KEY=replace-with-at-least-50-random-characters
LOCAL_PASSWORD_ONLY=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=https://localhost:8443,https://127.0.0.1:8443
DB_PASSWORD=replace-with-a-unique-application-db-password
# Keep the database administrator password OUT of this application environment.
# Store it in .local/staging/secrets/postgres_password (see PHASE6.md).
EVIDENCE_S3_BUCKET=your-private-versioned-evidence-bucket
AWS_REGION=us-east-1
# Prefer a workload role. If local staging requires credentials, keep them in this private file.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
EVIDENCE_S3_KMS_KEY_ID=
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=your-smtp-host
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=pilot@your-domain.example
AI_ALLOW_EXTERNAL=false
MONITORING_LIVE_ENABLED=false
# OPENAI_API_KEY=
# OPENAI_MODEL=
# MONITOR_SECRET_ENTRA=
# MONITOR_SECRET_HIBP=
# MONITOR_SECRET_AWS_EXTERNAL_ID=
