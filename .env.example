DJANGO_DEBUG=true
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,[::1]
DB_NAME=cyber_underwriting
DB_USER=cyber
DB_PASSWORD=replace-with-your-database-password
DB_HOST=127.0.0.1
DB_PORT=5432
# Local email files are stored in .local/mail, never sent over the network.
EMAIL_BACKEND=django.core.mail.backends.filebased.EmailBackend

# Development uploads stay private on disk. Use s3 for a real insurer pilot.
EVIDENCE_STORAGE_BACKEND=local
EVIDENCE_SCAN_MODE=basic
# S3 uses the standard AWS credential chain (prefer an IAM role).
# EVIDENCE_STORAGE_BACKEND=s3
# EVIDENCE_S3_BUCKET=your-private-versioned-bucket
# AWS_REGION=us-east-1
# EVIDENCE_S3_KMS_KEY_ID=your-kms-key-arn
# Production requires a scanner. Command is a JSON argument list, not a shell string.
# EVIDENCE_SCAN_MODE=external
# EVIDENCE_SCAN_COMMAND=["clamscan","--no-summary"]
